# Copy to .dev.vars for `npm run dev` (never commit .dev.vars). Set the same names as
# Cloudflare Pages secrets for production.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
CRON_SECRET=long-random-string
# 32 random bytes, base64:  openssl rand -base64 32
ENCRYPTION_KEY=

# Twilio parent (ISV) account — dealership subaccounts are created under it
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PRIMARY_CUSTOMER_PROFILE_SID=BU...      # your approved Primary Customer Profile
# Platform sender for staff alerts (its own 10DLC campaign on the parent account)
TWILIO_PLATFORM_MESSAGING_SERVICE_SID=MG...   # or TWILIO_FROM=+1...
PLATFORM_COMPLIANCE_EMAIL=compliance@aiautoengine.com
WEBHOOK_BASE_URL=https://nsbchevy.aiautoengine.com

# Email (Resend)
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...
PLATFORM_EMAIL_DOMAIN=mail.aiautoengine.com    # verified in Resend; fallback sender for dealerships without their own domain
INBOUND_EMAIL_DOMAIN=reply.aiautoengine.com    # Cloudflare Email Routing → workers/email-inbound
INBOUND_EMAIL_SECRET=long-random-string

# Inventory feeds by SFTP (SFTP To Go). One account for the platform; one SFTP login per dealership,
# named after the dealership slug, home folder /<slug>. Webhook -> https://<any dealer>.aiautoengine.com/api/inventory/sftp
SFTPTOGO_WEBHOOK_SECRET=...
SFTPTOGO_ACCESS_KEY_ID=...
SFTPTOGO_SECRET_ACCESS_KEY=...
SFTPTOGO_BUCKET=...
# SFTPTOGO_REGION=us-east-1

# VinAudit: VIN decoder (factory data, factory equipment sheet). One query (~$0.10) per VIN, cached.
VINAUDIT_API_KEY=
# Set to 1 only once VinAudit's separate window sticker API is enabled on the same key ("coming soon" as of Oct 2026)
# VINAUDIT_WINDOW_STICKERS=1
